import React from "react";
import { BrowserRouter as Router, Routes, Route } from "react-router-dom";
import Home from "./Home";
import Dashboard from "./Dashboard";
import CropForm from "./CropForm";
import WeatherForm from "./WeatherForm";
import YieldForm from "./YieldForm";
import CropHistory from "./CropHistory";
import PesticideSuggestion from "./PesticideSuggestion";
import LLMAssistant from "./LLMAssistant";
import LoginForm from "./LoginForm";
import RegisterForm from "./RegisterForm";
import Navbar from "./Navbar";

export default function App() {
  return (
    <Router>
      <Navbar />
      <Routes>
        <Route path="/" element={<Home />} />
        <Route path="/dashboard" element={<Dashboard />} />
        <Route path="/crop-recommendation" element={<CropForm />} />
        <Route path="/weather" element={<WeatherForm />} />
        <Route path="/yield-prediction" element={<YieldForm />} />
        <Route path="/crop-history" element={<CropHistory />} />
        <Route path="/pesticide" element={<PesticideSuggestion />} />
        <Route path="/assistant" element={<LLMAssistant />} />
        <Route path="/login" element={<LoginForm />} />
        <Route path="/register" element={<RegisterForm />} />
      </Routes>
    </Router>
  );
}
  const backgroundImage =
    "https://images.unsplash.com/photo-1593958163473-1eaa983bdf47?auto=format&fit=crop&w=1950&q=80";

  return (
